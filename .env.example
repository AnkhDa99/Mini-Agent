# Mini Agent 部署配置模板
# 复制为 .env 并填写实际值

# MySQL
MYSQL_PASSWORD=<mysql-root-password>

# Auth
JWT_SECRET_KEY=<generate-a-random-key>
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=<admin-password>

# LLM (OpenAI 兼容接口)
OPENAI_API_KEY=<your-api-key>
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ── 多Agent模型角色（空则回退到 OPENAI_MODEL） ──
# 典型配置：
#   CLASSIFIER_MODEL=deepseek-v4-flash    轻量，做分类
#   EVALUATOR_MODEL=deepseek-v4-flash     轻量，做质量评判
#   GENERATOR_MODEL=deepseek-v4-pro       核心，做最终回答生成
#   DOC_GENERATOR_MODEL=deepseek-v4-flash 轻量，做文档格式化
CLASSIFIER_MODEL=
EVALUATOR_MODEL=
GENERATOR_MODEL=
DOC_GENERATOR_MODEL=

# Embedding
EMBEDDING_API_KEY=<your-embedding-key>
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# Neo4j（可选，用于知识图谱）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<neo4j-password>

# Guest Login
REGISTRATION_ENABLED=false

# 调试
DEBUG=false
MOCK_LLM=false
